# =============================================================================
# Team-shared base image. Personal Dockerfiles (Dockerfile.local) inherit
# from this via the BASE_IMAGE build arg.
#
# CUSTOMIZE: Add team-wide and project-specific dependencies here
# (language runtimes, build tools, client libraries, etc.).
# Personal tooling (editors, AI CLIs) belongs in Dockerfile.local instead.
# =============================================================================

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y \
  curl \
  git \
  ca-certificates \
  zsh \
  sudo \
  && rm -rf /var/lib/apt/lists/*

# Create non-root user
ARG USERNAME=dev
ARG USER_UID=1000
ARG USER_GID=$USER_UID
RUN groupadd --gid $USER_GID $USERNAME \
  && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME -s /bin/zsh \
  && echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/$USERNAME

USER $USERNAME
WORKDIR /workspaces

